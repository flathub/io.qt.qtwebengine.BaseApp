{
    "name": "pciutils",
    "no-autogen": true,
    "make-args": [
        "SHARED=yes",
        "ZLIB=no"
    ],
    "make-install-args": [
        "SHAREDIR=${FLATPAK_DEST}/share/hwdata",
        "MANDIR=${FLATPAK_DEST}/share/man",
        "SBINDIR=${FLATPAK_DEST}/bin"
    ],
    "post-install": [
        "make install-lib"
    ],
    "sources": [
        {
            "type": "archive",
            "url": "https://mj.ucw.cz/download/linux/pci/pciutils-3.15.0.tar.gz",
            "mirror-urls": [
                "https://github.com/pciutils/pciutils/releases/download/v3.15.0/pciutils-3.15.0.tar.gz"
            ],
            "sha256": "a42e6e3f76fb6b1f6ac2e08cdd151f6bf78bc4f6312c591f4b6ec197582ede3a",
            "x-checker-data": {
                "type": "anitya",
                "project-id": 2605,
                "stable-only": true,
                "url-template": "https://mj.ucw.cz/download/linux/pci/pciutils-$version.tar.gz"
            }
        },
        {
            "type": "shell",
            "commands": [
                "sed -i 's@PREFIX=/usr/local@PREFIX='${FLATPAK_DEST}'@' Makefile",
                "sed -i '/^CFLAGS.*=/d' Makefile"
            ]
        }
    ],
    "cleanup": [
        "/bin",
        "/share"
    ]
}
